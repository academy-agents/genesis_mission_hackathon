# Update the following with endpoints
AURORA_ENDPOINT_ID=
AURORA_ACCOUNT=GenesisHackathonOct26
# PBS queue on Aurora. R8914313 is the hackathon reservation; it requires
# membership in the GenesisHackathonOct26 project. Use "debug" with your own
# allocation if you are not a member.
AURORA_QUEUE=R8914313

PERLMUTTER_ENDPOINT_ID=
PERLMUTTER_ACCOUNT=m5429
PERLMUTTER_RESERVATION=gm_hackathon_day1

FRONTIER_ENDPOINT_ID=
# Public Tutorial Endpoint ID
TUTORIAL_ENDPOINT_ID='4b116d3c-1703-4f8f-9f6f-39921e5864df'


# UserAgent's ID from dashboard.academy-agents.org
USER_AGENT_ID=

# Params for ChatOpenAI used in 02_langgraph example
LLM_MODEL=grok-4-1-fast-reasoning
# Alternative (no tool-calling support; 02_langgraph and 03_academy need tools):
# LLM_MODEL=gpt-6-luna
OPENAI_BASE_URL=https://mag.genesis.americansciencecloud.org/v1
# Follow instructions here to get you AMSC Token to authenticate
# with MAG: https://amsc-docs-d762d2.gitlab.io/mag-get-started
AMSC_TOKEN=
